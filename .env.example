# GTÜ Rehber ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri değiştirin.
# .env dosyası asla depoya yüklenmez.

# --- Portlar ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Ön yüzün API'ye ulaşacağı adres (tarayıcıdan) ---
VITE_API_URL=http://localhost:8000

# --- CORS: API'ye istek atmasına izin verilen adresler (virgülle ayrılır) ---
CORS_ORIGINS=http://localhost:3000

# --- Yerel dil modeli (Docker derlemesi sırasında Hugging Face'ten iner) ---
MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
MODEL_PATH=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# 0 = otomatik (fiziksel çekirdek sayısı, en fazla 8)
LLM_THREADS=0
LLM_CONTEXT=4096

# --- Veri ve veritabanı ---
DATA_DIR=/app/data
DB_PATH=/app/db/rehber.db

# --- Yönetici paneli (/admin) anahtarı: mutlaka değiştirin ---
ADMIN_KEY=buraya-guclu-bir-anahtar-yazin

# --- Debug modu (production için kapalı) ---
DEBUG=false
